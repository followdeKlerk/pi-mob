{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schemaVersion": 1,
  "upstreamPackage": "@earendil-works/pi-coding-agent@0.80.6",
  "source": "dist/modes/rpc/rpc-types.d.ts",
  "transport": {"stdin": "LF-delimited JSONL commands", "stdout": "LF-delimited JSONL responses and events", "correlationField": "id"},
  "commands": {
    "prompting": ["prompt", "steer", "follow_up", "abort"],
    "session": ["new_session", "get_state", "get_messages", "get_session_stats", "export_html", "switch_session", "fork", "clone", "get_fork_messages", "get_entries", "get_tree", "get_last_assistant_text", "set_session_name"],
    "model": ["set_model", "cycle_model", "get_available_models", "set_thinking_level", "cycle_thinking_level"],
    "queueAndCompaction": ["set_steering_mode", "set_follow_up_mode", "compact", "set_auto_compaction", "set_auto_retry", "abort_retry"],
    "bash": ["bash", "abort_bash"],
    "resources": ["get_commands"]
  },
  "response": {
    "success": {"type": "response", "fields": ["id?", "command", "success:true", "data?"]},
    "failure": {"type": "response", "fields": ["id?", "command", "success:false", "error"]}
  },
  "events": ["agent_start", "agent_end", "agent_settled", "turn_start", "turn_end", "message_start", "message_update", "message_end", "tool_execution_start", "tool_execution_update", "tool_execution_end", "queue_update", "compaction_start", "compaction_end", "auto_retry_start", "auto_retry_end", "extension_error"],
  "messageUpdateDeltaTypes": ["start", "text_start", "text_delta", "text_end", "thinking_start", "thinking_delta", "thinking_end", "toolcall_start", "toolcall_delta", "toolcall_end", "done", "error"],
  "extensionUi": {
    "requestType": "extension_ui_request",
    "dialogRequests": {
      "select": ["id", "method", "title", "options", "timeout?"],
      "confirm": ["id", "method", "title", "message", "timeout?"],
      "input": ["id", "method", "title", "placeholder?", "timeout?"],
      "editor": ["id", "method", "title", "prefill?"]
    },
    "presentationRequests": {
      "notify": ["id", "method", "message", "notifyType?"],
      "setStatus": ["id", "method", "statusKey", "statusText"],
      "setWidget": ["id", "method", "widgetKey", "widgetLines", "widgetPlacement?"],
      "setTitle": ["id", "method", "title"],
      "set_editor_text": ["id", "method", "text"]
    },
    "responses": {"value": ["type:extension_ui_response", "id", "value"], "confirm": ["type:extension_ui_response", "id", "confirmed"], "cancel": ["type:extension_ui_response", "id", "cancelled:true"]}
  },
  "resourceLoadingDependencies": [
    {"resource": "global extensions", "location": "$HOME/.pi/agent/extensions", "trustBearing": true},
    {"resource": "project extensions", "location": ".pi/extensions", "trustBearing": true, "gatedBy": "project_trust"},
    {"resource": "project dynamic resources", "locations": [".pi", ".agents/skills"], "trustBearing": true, "gatedBy": "project_trust"},
    {"resource": "settings packages/extensions", "location": "settings.json", "trustBearing": true},
    {"resource": "resources_discover contributions", "kinds": ["skillPaths", "promptPaths", "themePaths"], "trustBearing": true},
    {"resource": "prompt templates and skills", "exposedBy": "get_commands", "pathExposure": "host-only in pi-mob"}
  ],
  "adapterRules": ["Pi paths, raw RPC errors, and sourceInfo paths do not cross the bridge-mobile protocol.", "agent_settled, not agent_end, is the bridge idle boundary.", "Pi has no RPC session-list or delete-session command; listing/deletion require an adapter-owned tested path."]
}
