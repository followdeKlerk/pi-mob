{
  "$id": "pi-mob/protocol/attachment",
  "additionalProperties": true,
  "properties": {
    "attachmentId": {
      "$id": "pi-mob/protocol/uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "bytes": {
      "maximum": 10485760,
      "minimum": 0,
      "type": "integer"
    },
    "expiresAt": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3})?Z$",
      "type": "string"
    },
    "height": {
      "minimum": 1,
      "type": "integer"
    },
    "mimeType": {
      "anyOf": [
        {
          "const": "image/jpeg",
          "type": "string"
        },
        {
          "const": "image/png",
          "type": "string"
        }
      ]
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "width": {
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "attachmentId",
    "sha256",
    "mimeType",
    "bytes",
    "expiresAt"
  ],
  "type": "object"
}
