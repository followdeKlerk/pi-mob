{
  "$id": "pi-mob/protocol/export",
  "additionalProperties": true,
  "properties": {
    "bytes": {
      "minimum": 0,
      "type": "integer"
    },
    "expiresAt": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3})?Z$",
      "type": "string"
    },
    "exportId": {
      "$id": "pi-mob/protocol/uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "format": {
      "const": "html",
      "type": "string"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "exportId",
    "format",
    "bytes",
    "sha256",
    "expiresAt"
  ],
  "type": "object"
}
