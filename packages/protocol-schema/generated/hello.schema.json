{
  "$id": "pi-mob/protocol/hello",
  "additionalProperties": true,
  "properties": {
    "connectionId": {
      "$id": "pi-mob/protocol/uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "messageId": {
      "$id": "pi-mob/protocol/uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "payload": {
      "additionalProperties": true,
      "properties": {
        "expectedHostId": {
          "$id": "pi-mob/protocol/uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "type": "string"
        },
        "installationCredential": {
          "minLength": 1,
          "type": "string"
        },
        "installationId": {
          "$id": "pi-mob/protocol/uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "type": "string"
        },
        "mobileVersion": {
          "minLength": 1,
          "type": "string"
        },
        "optionalCapabilities": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "platform": {
          "minLength": 1,
          "type": "string"
        },
        "requiredCapabilities": {
          "items": {
            "$id": "pi-mob/protocol/capability",
            "anyOf": [
              {
                "const": "streams.v1",
                "type": "string"
              },
              {
                "const": "commands.v1",
                "type": "string"
              },
              {
                "const": "controller_leases.v1",
                "type": "string"
              },
              {
                "const": "attachments.v1",
                "type": "string"
              },
              {
                "const": "extension_dialogs.v1",
                "type": "string"
              },
              {
                "const": "notifications.v1",
                "type": "string"
              },
              {
                "const": "files.v1",
                "type": "string"
              },
              {
                "const": "contexts.v1",
                "type": "string"
              },
              {
                "const": "runtime.processes.v1",
                "type": "string"
              },
              {
                "const": "git-ci.v1",
                "type": "string"
              },
              {
                "const": "attention.v1",
                "type": "string"
              },
              {
                "const": "agents.v1",
                "type": "string"
              },
              {
                "const": "catalogue.v1",
                "type": "string"
              },
              {
                "const": "raw_rpc.v1",
                "type": "string"
              },
              {
                "const": "session_events.v2",
                "type": "string"
              }
            ]
          },
          "type": "array"
        }
      },
      "required": [
        "mobileVersion",
        "platform",
        "installationId",
        "installationCredential",
        "requiredCapabilities",
        "optionalCapabilities"
      ],
      "type": "object"
    },
    "protocol": {
      "$id": "pi-mob/protocol/version",
      "additionalProperties": true,
      "properties": {
        "major": {
          "const": 1,
          "type": "number"
        },
        "minor": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "major",
        "minor"
      ],
      "type": "object"
    },
    "requestId": {
      "$id": "pi-mob/protocol/uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "sentAt": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3})?Z$",
      "type": "string"
    },
    "type": {
      "const": "hello",
      "type": "string"
    }
  },
  "required": [
    "protocol",
    "messageId",
    "type",
    "sentAt",
    "payload",
    "requestId"
  ],
  "type": "object"
}
