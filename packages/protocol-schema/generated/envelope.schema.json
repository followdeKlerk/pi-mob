{
  "$id": "pi-mob/protocol/envelope",
  "additionalProperties": true,
  "properties": {
    "commandId": {
      "$id": "pi-mob/protocol/uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "connectionId": {
      "$id": "pi-mob/protocol/uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "cursor": {
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "leaseId": {
      "$id": "pi-mob/protocol/uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "messageId": {
      "$id": "pi-mob/protocol/uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "payload": {
      "additionalProperties": true,
      "properties": {},
      "type": "object"
    },
    "protocol": {
      "$id": "pi-mob/protocol/version",
      "additionalProperties": true,
      "properties": {
        "major": {
          "const": 1,
          "type": "number"
        },
        "minor": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "major",
        "minor"
      ],
      "type": "object"
    },
    "requestId": {
      "$id": "pi-mob/protocol/uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "sentAt": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3})?Z$",
      "type": "string"
    },
    "streamId": {
      "pattern": "^(host|session):[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "type": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "protocol",
    "messageId",
    "type",
    "sentAt",
    "payload"
  ],
  "type": "object"
}
