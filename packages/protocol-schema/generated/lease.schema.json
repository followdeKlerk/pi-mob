{
  "$id": "pi-mob/protocol/lease-state",
  "anyOf": [
    {
      "additionalProperties": true,
      "properties": {
        "expiresAt": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3})?Z$",
          "type": "string"
        },
        "installationId": {
          "$id": "pi-mob/protocol/uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "type": "string"
        },
        "leaseId": {
          "$id": "pi-mob/protocol/uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "type": "string"
        },
        "mode": {
          "minLength": 1,
          "type": "string"
        },
        "reclaimableUntil": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3})?Z$",
          "type": "string"
        },
        "scope": {
          "const": "host",
          "type": "string"
        }
      },
      "required": [
        "mode",
        "scope"
      ],
      "type": "object"
    },
    {
      "additionalProperties": true,
