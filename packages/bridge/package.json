{
  "name": "@pi-mob/bridge",
  "version": "0.0.3-alpha.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config.ts",
    "./logger": "./src/logger.ts",
    "./smoke": "./src/smoke.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "daemon": "bun run src/daemon.ts",
    "build:smoke": "bun build --compile --no-compile-autoload-dotenv --no-compile-autoload-bunfig --outfile ./dist/bridge-smoke ./src/smoke.ts"
  },
  "dependencies": {
    "@fastify/busboy": "3.2.0",
    "@pi-mob/protocol-schema": "workspace:*",
    "jpeg-js": "0.4.4",
    "pngjs": "7.0.0"
  },
  "devDependencies": {
    "@pi-mob/typescript-config": "workspace:*",
    "@types/jpeg-js": "0.3.7",
    "@types/pngjs": "6.0.5",
    "@sinclair/typebox": "0.34.52"
  }
}
