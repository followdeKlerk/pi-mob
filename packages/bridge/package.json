{
  "name": "@pi-mob/bridge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config.ts",
    "./logger": "./src/logger.ts",
    "./smoke": "./src/smoke.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
